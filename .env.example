# Copy to .env. Keep actual credentials out of Git and chat.
# Only fill the integrations you are testing. npm run demo needs none.
# UF Entra app registered for local delegated Microsoft Graph sign-in.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
# IDs become available after the team chooses the maintained workbook location.
MICROSOFT_DRIVE_ID=
MICROSOFT_RESEARCHERS_ITEM_ID=
MICROSOFT_ACCOUNTS_ITEM_ID=

# Set a dedicated project SSO profile after verifying the AWS account and role.
AWS_PROFILE=
AWS_REGION=
RECOMMENDATION_RUNS_TABLE=
RECOMMENDATION_RESULTS_TABLE=

# Optional bounded explanation provider. Scoring remains deterministic.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
