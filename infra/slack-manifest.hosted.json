{
  "display_information": {
    "name": "Research Resourcing",
    "description": "Research staffing requests, recommendations, and approvals",
    "background_color": "#173b4b"
  },
  "features": {
    "bot_user": {
      "display_name": "Research Resourcing",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/resourcing",
        "description": "Staffing requests, approvals, and assignment changes",
        "should_escape": false,
        "usage_hint": "[list | assignments | hq | issues | metrics | import | managers | help]",
        "url": "https://n2a5agvdeg35cldwmv6eo72o3u0zmavm.lambda-url.us-east-2.on.aws/"
      }
    ],
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "commands",
        "chat:write",
        "files:read"
      ]
    }
  },
  "settings": {
    "socket_mode_enabled": false,
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://n2a5agvdeg35cldwmv6eo72o3u0zmavm.lambda-url.us-east-2.on.aws/"
    },
    "org_deploy_enabled": false
  }
